model Payment {
  id String @id @default(uuid())

  // Make subscriptionId OPTIONAL (?) so one-time purchases can work
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // ADD userId directly to Payment for easy "My History" queries
  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount          Float
  currency        String  @default("usd")
  stripePaymentId String? @unique
  status          String // e.g., "COMPLETED", "FAILED"

  // Link to the specific purchase/rental
  mediaPurchaseId String?
  mediaPurchase   MediaPurchase? @relation(fields: [mediaPurchaseId], references: [id])

  createdAt DateTime @default(now())
  rental    Rental?  @relation(fields: [rentalId], references: [id])
  rentalId  String?

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}
