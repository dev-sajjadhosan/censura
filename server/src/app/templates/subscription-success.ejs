<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family:
          "Inter",
          -apple-system,
          sans-serif;
        background-color: #050505;
        margin: 0;
        padding: 0;
        color: #ffffff;
      }
      .container {
        max-width: 550px;
        margin: 40px auto;
        background-color: #0f0f0f;
        border: 1px solid #222;
        border-radius: 12px;
        overflow: hidden;
      }
      .content {
        padding: 40px;
      }
      .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 100px;
        background: #065f46;
        color: #34d399;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 20px;
        text-transform: uppercase;
      }
      h1 {
        font-size: 24px;
        margin: 0 0 10px;
        letter-spacing: -0.02em;
        color: #ffffff;
      }
      p {
        color: #a1a1aa;
        line-height: 1.6;
        font-size: 15px;
      }
      .card {
        background: #161616;
        border: 1px solid #262626;
        border-radius: 8px;
        margin: 30px 0;
        padding: 20px;
      }
      .label {
        color: #71717a;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 4px;
      }
      .value {
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
      }
      .btn {
        display: inline-block;
        background: #ffffff;
        color: #000000 !important;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        margin-top: 10px;
      }
      .footer {
        padding: 20px 40px;
        background: #0a0a0a;
        border-top: 1px solid #1a1a1a;
        color: #52525b;
        font-size: 12px;
      }
      a {
        color: #ffffff;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="content">
        <div class="badge">Success</div>
        <h1>Unlock the full experience</h1>
        <p>
          Welcome to the inner circle, <%= userName %>. Your premium access to
          Censura is now fully active.
        </p>

        <div class="card">
          <div style="margin-bottom: 15px">
            <div class="label">Current Plan</div>
            <div class="value"><%= plan %> Membership</div>
          </div>
          <div>
            <div class="label">Renewal Date</div>
            <div class="value"><%= endDate %></div>
          </div>
        </div>

        <a href="<%= loginUrl %>" class="btn">Start Watching Now</a>
      </div>
      <div class="footer">
        &copy; 2026 Censura Inc. &bull;
        <a href="<%= loginUrl %>">Billing Portal</a>
      </div>
    </div>
  </body>
</html>
