model Media {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  type           MediaType
  synopsis       String    @db.Text
  releaseYear    Int
  director       String
  cast           String[]
  posterUrl      String?
  backdropUrl    String?
  trailerUrl     String?
  streamingUrl   String?
  runtimeMinutes Int?
  seasons        Int?
  pricing        Pricing   @default(FREE)
  isPublished    Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  avgRating      Float?
  reviewCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  genres         Genre[]         @relation("MediaGenres")
  platforms      MediaPlatform[]
  reviews        Review[]
  watchlistItems Watchlist[] // Need to match Watchlist model relations

  viewCount Int        @default(0)
  likes     Like[]
  comments  Comment[]
  bookmarks Bookmark[]
  favorites Favorite[]
  purchases MediaPurchase[]

  @@unique([title, releaseYear])
  @@index([title])
  @@index([type])
  @@index([releaseYear])
  @@index([director])
  @@index([cast])
  @@index([pricing])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([viewCount])
  @@map("media")
}
